from {% endraw %}{{ package_name }}{% raw %}.data.records import ProjectRecord


def test_foreign_keys_are_enforced(session: Session):
    session.add(ProjectRecord(org_id="org_missing", owner_id="usr_missing", name="Orphan"))

    with pytest.raises(IntegrityError):
        session.flush()


def test_file_databases_use_write_ahead_logging(settings: Settings, tmp_path: Path):
    engine = make_engine(settings, url=f"sqlite:///{tmp_path / 'app.db'}")
    try:
        with engine.connect() as connection:
            assert connection.execute(text("PRAGMA journal_mode")).scalar() == "wal"
            assert connection.execute(text("PRAGMA foreign_keys")).scalar() == 1
            assert connection.execute(text("PRAGMA busy_timeout")).scalar() == 5000
    finally:
        engine.dispose()
