{% raw %}import pytest

from {% endraw %}{{ package_name }}{% raw %}.core.exceptions import (
    NoOrgAccessError,
    OrgNotFoundError,
    OrgSelectionRequiredError,
)
from {% endraw %}{{ package_name }}{% raw %}.core.models import Actor, Role
from {% endraw %}{{ package_name }}{% raw %}.orchestrators import IdentityOrchestrator
from tests.{% endraw %}{{ package_name }}{% raw %}.fixtures.factories import MemberFactory, OrgFactory


def test_resolves_the_only_membership(identity: IdentityOrchestrator, sample_member: Actor):
    assert identity.resolve_actor(sample_member.user_id, org_id=None) == sample_member


def test_multi_org_user_must_choose(
    identity: IdentityOrchestrator,
    make_org: OrgFactory,
    make_member: MemberFactory,
    sample_member: Actor,
):
    second_org = make_org(name="Second")
    make_member(second_org, role=Role.ADMIN, existing_user_id=sample_member.user_id)

    with pytest.raises(OrgSelectionRequiredError):
        identity.resolve_actor(sample_member.user_id, org_id=None)
    chosen = identity.resolve_actor(sample_member.user_id, org_id=second_org.id)
    assert chosen == Actor(user_id=sample_member.user_id, org_id=second_org.id, role=Role.ADMIN)


def test_rejects_org_the_user_does_not_belong_to(
    identity: IdentityOrchestrator, sample_member: Actor, other_org_admin: Actor
):
    with pytest.raises(OrgNotFoundError):
        identity.resolve_actor(sample_member.user_id, org_id=other_org_admin.org_id)


def test_rejects_user_without_memberships(identity: IdentityOrchestrator):
    with pytest.raises(NoOrgAccessError):
        identity.resolve_actor("usr_nobody", org_id=None)


def test_profile_describes_actor(identity: IdentityOrchestrator, sample_admin: Actor):
    profile = identity.get_profile(sample_admin)

    assert profile.user.id == sample_admin.user_id
    assert profile.org.name == "Acme"
    assert profile.role == Role.ADMIN
