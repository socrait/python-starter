{% raw %}from collections.abc import Iterable
from typing import Protocol
from uuid import uuid4

import pytest
from sqlalchemy.orm import Session

from {% endraw %}{{ package_name }}{% raw %}.core.models import Actor, Role, TaskStatus
from {% endraw %}{{ package_name }}{% raw %}.data.records import (
    MembershipRecord,
    OrgRecord,
    ProjectRecord,
    TaskAssigneeRecord,
    TaskRecord,
    UserRecord,
    utcnow,
)


class OrgFactory(Protocol):
    def __call__(self, *, name: str = ...) -> OrgRecord: ...


class MemberFactory(Protocol):
    def __call__(
        self,
        org: OrgRecord,
        *,
        role: Role = ...,
        email: str | None = ...,
        existing_user_id: str | None = ...,
    ) -> Actor: ...


class ProjectFactory(Protocol):
    def __call__(
        self, owner: Actor, *, name: str = ..., description: str = ..., deleted: bool = ...
    ) -> ProjectRecord: ...


class TaskFactory(Protocol):
    def __call__(
        self,
        project: ProjectRecord,
        *,
        title: str = ...,
        status: TaskStatus = ...,
        assignee_ids: Iterable[str] = ...,
    ) -> TaskRecord: ...


# Factories flush rather than commit: the session fixture rolls everything back.


@pytest.fixture
def make_org(session: Session) -> OrgFactory:
    def _make(*, name: str = "Test Org") -> OrgRecord:
        record = OrgRecord(name=name)
        session.add(record)
        session.flush()
        return record

    return _make


@pytest.fixture
def make_member(session: Session) -> MemberFactory:
    def _make(
        org: OrgRecord,
        *,
        role: Role = Role.MEMBER,
        email: str | None = None,
        existing_user_id: str | None = None,
    ) -> Actor:
        user_id = existing_user_id
        if user_id is None:
            user = UserRecord(
                email=email or f"user-{uuid4().hex[:8]}@example.com", display_name="Test User"
            )
            session.add(user)
            session.flush()
            user_id = user.id
        session.add(MembershipRecord(org_id=org.id, user_id=user_id, role=role))
        session.flush()
        return Actor(user_id=user_id, org_id=org.id, role=role)

    return _make


@pytest.fixture
def make_project(session: Session) -> ProjectFactory:
    def _make(
        owner: Actor, *, name: str = "Test Project", description: str = "", deleted: bool = False
    ) -> ProjectRecord:
        record = ProjectRecord(
