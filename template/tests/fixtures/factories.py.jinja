@pytest.fixture
def make_task(session: Session) -> TaskFactory:
    def _make(
        project: ProjectRecord,
        *,
        title: str = "Test Task",
        status: TaskStatus = TaskStatus.OPEN,
        assignee_ids: Iterable[str] = (),
    ) -> TaskRecord:
        record = TaskRecord(
            org_id=project.org_id,
            project_id=project.id,
            title=title,
            status=status,
            completed_at=utcnow() if status == TaskStatus.DONE else None,
            assignees=[TaskAssigneeRecord(user_id=user_id) for user_id in assignee_ids],
        )
        session.add(record)
        session.flush()
        return record

    return _make


