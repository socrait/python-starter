{% raw %}# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Images are pinned by digest (tags can be moved); Renovate keeps the digests current.
FROM python:3.15-slim@sha256:2fb224844bc0ebfca5f117d1c0b93895652c8ceb01acf2c8c54c3d3a44bdcc7c AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# Dependencies first, so code changes don't invalidate the dependency layer.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --no-editable

FROM python:3.15-slim@sha256:2fb224844bc0ebfca5f117d1c0b93895652c8ceb01acf2c8c54c3d3a44bdcc7c
# pip isn't needed at runtime, and its bundled libraries are a recurring source of CVEs.
RUN python -m pip uninstall --yes --quiet pip \
    && useradd --system --uid 10001 --no-create-home app
# Owned by root: the app can run its code but not change it.
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    {% endraw %}{{ env_prefix }}{% raw %}_HOST=0.0.0.0 \
    {% endraw %}{{ env_prefix }}{% raw %}_ENVIRONMENT=production
{% endraw %}{% if database == "sqlite" %}{% raw %}# The database file lives on a volume; mount durable storage at /data.
RUN mkdir /data && chown app:app /data
ENV {% endraw %}{{ env_prefix }}{% raw %}_DATABASE_URL=sqlite:////data/{% endraw %}{{ package_name }}{% raw %}.db
VOLUME /data
{% endraw %}{% endif %}{% raw %}USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"{% endraw %}{{ env_prefix }}{% raw %}_PORT\", \"8000\")}/health')"]
# Run migrations as a separate one-off step before rolling out: `app db migrate`.
CMD ["app", "serve"]
{% endraw %}