{% raw %}from sqlalchemy import select, update
from sqlalchemy.orm import Session

from {% endraw %}{{ package_name }}{% raw %}.core.models import Actor
from {% endraw %}{{ package_name }}{% raw %}.data.pagination import PageRequest, PageSlice, apply_keyset_page, slice_page
from {% endraw %}{{ package_name }}{% raw %}.data.query_scope import QueryScope
from {% endraw %}{{ package_name }}{% raw %}.data.records import ProjectRecord, utcnow


class ProjectRepository:
    def __init__(self, session: Session):
        self._session = session

    def get_project(self, actor: Actor, project_id: str) -> ProjectRecord | None:
        predicate = QueryScope.from_actor(actor).where(ProjectRecord)
        return self._session.execute(
            select(ProjectRecord).where(predicate).where(ProjectRecord.id == project_id)
        ).scalar_one_or_none()

    def list_projects(self, actor: Actor, page: PageRequest) -> PageSlice[ProjectRecord]:
        predicate = QueryScope.from_actor(actor).where(ProjectRecord)
        stmt = apply_keyset_page(select(ProjectRecord).where(predicate), ProjectRecord.id, page)
        rows = self._session.execute(stmt).scalars().all()
        return slice_page(rows, page, id_of=lambda r: r.id)

    def create_project(
        self, *, org_id: str, owner_id: str, name: str, description: str
    ) -> ProjectRecord:
        record = ProjectRecord(org_id=org_id, owner_id=owner_id, name=name, description=description)
        self._session.add(record)
        self._session.flush()
        return record

    def soft_delete_project(self, actor: Actor, project_id: str) -> bool:
        """True if a visible, not-yet-deleted project was deleted."""
        predicate = QueryScope.from_actor(actor).where(ProjectRecord)
        deleted_id = self._session.execute(
            update(ProjectRecord)
            .where(predicate)
            .where(ProjectRecord.id == project_id)
            .values(deleted_at=utcnow())
            .returning(ProjectRecord.id)
        ).scalar_one_or_none()
        return deleted_id is not None
