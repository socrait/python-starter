{% raw %}from sqlalchemy import select
from sqlalchemy.orm import Session

from {% endraw %}{{ package_name }}{% raw %}.core.models import Actor
from {% endraw %}{{ package_name }}{% raw %}.data.records import OrgRecord


class OrgRepository:
    def __init__(self, session: Session):
        self._session = session

    def get_actor_org(self, actor: Actor) -> OrgRecord | None:
        return self._session.execute(
            select(OrgRecord).where(OrgRecord.id == actor.org_id)
        ).scalar_one_or_none()

    def create_org(self, *, name: str) -> OrgRecord:
        record = OrgRecord(name=name)
        self._session.add(record)
        self._session.flush()
        return record
