{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommitsDisabled"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The exact uv version CI installs (setup-uv input, GitLab image tag)",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/^\\.gitlab-ci\\.yml$/"],
      "matchStrings": [
        "version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "ghcr\\.io/astral-sh/uv:(?<currentValue>\\d+\\.\\d+\\.\\d+)-python"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv"
    },
    {
      "customType": "regex",
      "description": "The ast-grep rule schema, pinned to the locked ast-grep release",
      "managerFilePatterns": ["/^\\.pre-commit-config\\.yaml$/"],
      "matchStrings": ["ast-grep/ast-grep/(?<currentValue>\\d+\\.\\d+\\.\\d+)/schemas"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ast-grep/ast-grep"
    }
  ],
  "packageRules": [
    {
      "description": "Group dev tooling so one PR moves them together",
      "matchDepTypes": ["dependency-groups"],
      "groupName": "dev tooling"
    },
    {
      "description": "Move every copy of uv together: CI, the Dockerfile, the build backend",
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv", "uv_build"],
      "groupName": "uv"
    },
    {
      "matchManagers": ["github-actions", "pre-commit", "dockerfile", "docker-compose", "gitlabci"],
      "groupName": "ci and container images"
    }
  ],
  "pre-commit": { "enabled": true }
}
